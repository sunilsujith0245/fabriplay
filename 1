<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Boutique Business Model Masterclass</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
/* ============================================
   ADMIN: EDIT COLORS & DETAILS HERE
   ============================================ */
:root {
  --white: #FFFFFF;
  --off-white: #FAFAFA;
  --light-grey: #F3F3F3;
  --soft-grey: #E5E5E5;
  --border-grey: #979797;
  --black: #000000;
  --charcoal: #1A1A1A;
  --dark-text: #111111;
  --body-text: #2D2D2D;
  --muted: #4A4A4A;
  --primary-purple: #7F00FF;
  --light-purple: #B266FF;
  --purple-hover: #5E00CC;
  --deep-purple: #3D0080;
  --yellow-accent: #FFD600;
  --yellow-dark: #D4B200;
  --purple-bg: rgba(127,0,255,0.05);
  --purple-bg2: rgba(127,0,255,0.08);
}

/* ============================================
   RESET
   ============================================ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:'DM Sans',sans-serif;
  color:var(--dark-text);
  background:var(--white);
  overflow-x:hidden;
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
button{font-family:inherit}

/* ============================================
   LAYOUT
   ============================================ */
.container{max-width:1060px;margin:0 auto;padding:0 20px}

.section-tag{
  display:inline-block;
  font-family:'Space Grotesk',sans-serif;
  font-size:12px;font-weight:700;
  color:var(--primary-purple);
  background:var(--purple-bg2);
  padding:5px 14px;border-radius:100px;
  margin-bottom:14px;
  text-transform:uppercase;letter-spacing:0.8px;
}
.section-title{
  font-family:'Space Grotesk',sans-serif;
  font-size:clamp(24px,3.8vw,38px);
  font-weight:800;color:var(--dark-text);
  line-height:1.18;margin-bottom:10px;
}
.section-sub{
  font-size:16px;color:var(--body-text);
  line-height:1.65;margin-bottom:32px;
  max-width:560px;
}

/* ============================================
   CTA BUTTONS
   ============================================ */
.cta-btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  font-family:'Space Grotesk',sans-serif;
  font-size:16px;font-weight:700;
  padding:15px 32px;border:none;border-radius:10px;
  cursor:pointer;position:relative;
  transition:all .25s ease;
}
.cta-btn--purple{
  background:var(--primary-purple);color:var(--white);
  box-shadow:0 4px 20px rgba(127,0,255,.3);
  animation:glow-p 2.5s infinite;
}
.cta-btn--purple:hover{background:var(--purple-hover);transform:translateY(-2px);box-shadow:0 8px 30px rgba(127,0,255,.4)}
@keyframes glow-p{0%,100%{box-shadow:0 4px 20px rgba(127,0,255,.3)}50%{box-shadow:0 4px 32px rgba(127,0,255,.5)}}

.cta-btn--yellow{
  background:var(--yellow-accent);color:var(--black);
  box-shadow:0 4px 20px rgba(255,214,0,.35);
  animation:glow-y 2.5s infinite;
}
.cta-btn--yellow:hover{background:var(--yellow-dark);transform:translateY(-2px);box-shadow:0 8px 30px rgba(255,214,0,.45)}
@keyframes glow-y{0%,100%{box-shadow:0 4px 20px rgba(255,214,0,.35)}50%{box-shadow:0 4px 32px rgba(255,214,0,.55)}}

.cta-btn--outline{
  background:transparent;color:var(--white);
  border:2px solid rgba(255,255,255,.3);
  box-shadow:none;animation:none;
}
.cta-btn--outline:hover{border-color:var(--white);background:rgba(255,255,255,.08)}

.cta-btn .arrow{display:inline-block;transition:transform .25s}
.cta-btn:hover .arrow{transform:translateX(4px)}

.cta-group{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.cta-note{font-size:12px;color:var(--muted);margin-top:8px}
.cta-note b{color:var(--primary-purple)}
.cta-note--light{color:rgba(255,255,255,.45)}
.cta-note--light b{color:var(--yellow-accent)}

/* ============================================
   SCROLL ANIMATIONS
   ============================================ */
.rv{opacity:0;transform:translateY(28px);transition:opacity .55s ease,transform .55s ease}
.rv.v{opacity:1;transform:translateY(0)}
.rv-l{opacity:0;transform:translateX(-35px);transition:opacity .55s ease,transform .55s ease}
.rv-l.v{opacity:1;transform:translateX(0)}
.rv-r{opacity:0;transform:translateX(35px);transition:opacity .55s ease,transform .55s ease}
.rv-r.v{opacity:1;transform:translateX(0)}

/* ============================================
   SECTION 1: HERO
   ============================================ */
.hero{
  background:linear-gradient(150deg,#080012 0%,#140028 35%,var(--charcoal) 100%);
  position:relative;overflow:hidden;
  padding:56px 0 48px;
}
.hero::before{
  content:'';position:absolute;
  top:-180px;right:-180px;width:460px;height:460px;
  background:radial-gradient(circle,rgba(127,0,255,.16) 0%,transparent 70%);
  pointer-events:none;
}
.hero-particles{position:absolute;inset:0;pointer-events:none}
.dot{
  position:absolute;width:5px;height:5px;
  background:var(--primary-purple);border-radius:50%;
  opacity:.2;animation:dotf 7s ease-in-out infinite;
}
.dot:nth-child(1){top:12%;left:6%;animation-delay:0s}
.dot:nth-child(2){top:50%;left:88%;animation-delay:1.5s;width:3px;height:3px}
.dot:nth-child(3){top:78%;left:22%;animation-delay:3s;width:6px;height:6px}
.dot:nth-child(4){top:6%;left:62%;animation-delay:.7s}
@keyframes dotf{0%,100%{transform:translateY(0);opacity:.2}50%{transform:translateY(-20px);opacity:.45}}

.hero-grid{
  position:relative;z-index:2;
  display:grid;grid-template-columns:1fr 1fr;
  gap:40px;align-items:center;
}

/* --- Hero left --- */
.hero-left{display:flex;flex-direction:column}

.pre-hl{
  display:inline-flex;align-self:flex-start;
  font-family:'Space Grotesk',sans-serif;
  font-size:12px;font-weight:700;
  color:var(--yellow-accent);
  background:rgba(255,214,0,.1);
  border:1px solid rgba(255,214,0,.22);
  padding:5px 14px;border-radius:100px;
  margin-bottom:18px;letter-spacing:.4px;
  animation:fadeD .5s ease forwards;
}
@keyframes fadeD{from{opacity:0;transform:translateY(-12px)}to{opacity:1;transform:translateY(0)}}

.hero-h{
  font-family:'Space Grotesk',sans-serif;
  font-size:clamp(26px,4.2vw,46px);
  font-weight:800;line-height:1.14;color:var(--white);
}
.hero-h .ln{
  display:block;
  text-shadow:0 1px 0 #aaa,0 2px 6px rgba(127,0,255,.25);
  animation:fadeU .6s ease forwards;opacity:0;
}
.hero-h .ln:nth-child(1){animation-delay:.1s}
.hero-h .ln:nth-child(2){animation-delay:.3s}
.hero-h .ln:nth-child(3){
  animation-delay:.5s;color:var(--yellow-accent);
  text-shadow:0 1px 0 #d4b200,0 2px 6px rgba(255,214,0,.25);
}
@keyframes fadeU{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

.hero-sub{
  font-size:16px;color:rgba(255,255,255,.72);
  line-height:1.7;margin:18px 0 0;max-width:460px;
  animation:fadeU .6s ease .65s forwards;opacity:0;
}

/* Mobile-only image slot (hidden on desktop) */
.hero-img-mobile{display:none}

.hero-meta{
  display:flex;flex-wrap:wrap;gap:10px 16px;
  font-size:14px;font-weight:500;color:rgba(255,255,255,.6);
  margin:20px 0;
  animation:fadeU .6s ease .8s forwards;opacity:0;
}

.hero-cta{animation:fadeU .6s ease .95s forwards;opacity:0}

/* --- Hero right (image/video) --- */
.hero-right{animation:fadeU .7s ease .35s forwards;opacity:0}
.hero-frame{
  border-radius:14px;overflow:hidden;position:relative;
  box-shadow:0 16px 50px rgba(127,0,255,.18);
  border:2px solid rgba(127,0,255,.2);
}
.hero-placeholder{
  width:100%;aspect-ratio:4/3;
  background:linear-gradient(135deg,#140028,#2a0055);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:8px;color:rgba(255,255,255,.3);font-size:13px;
}
.video-embed{position:relative;padding-bottom:56.25%;height:0;background:#111}
.video-embed iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:none}

.fbadge{
  position:absolute;bottom:-14px;left:16px;
  background:var(--white);border-radius:10px;
  padding:10px 14px;box-shadow:0 6px 24px rgba(0,0,0,.1);
  display:flex;align-items:center;gap:10px;
  animation:bounce 3s ease-in-out infinite;
}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
.fbadge-ic{
  width:36px;height:36px;background:var(--primary-purple);
  border-radius:8px;display:flex;align-items:center;justify-content:center;
}
.fbadge-num{font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:800;color:var(--dark-text);line-height:1}
.fbadge-lbl{font-size:10px;color:var(--muted)}

/* ============================================
   SECTION 2: IS THIS YOU
   ============================================ */
.mirror{padding:60px 0;background:var(--light-grey)}
.mirror-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.m-card{
  background:var(--white);border:1px solid var(--soft-grey);
  border-radius:12px;padding:24px;position:relative;overflow:hidden;
  transition:all .3s ease;
}
.m-card:hover{transform:translateY(-3px);box-shadow:0 10px 32px rgba(127,0,255,.07);border-color:var(--light-purple)}
.m-card::before{
  content:'';position:absolute;top:0;left:0;width:3px;height:100%;
  background:var(--primary-purple);transform:scaleY(0);transform-origin:top;transition:transform .3s;
}
.m-card:hover::before{transform:scaleY(1)}
.m-card-ic{
  width:40px;height:40px;background:var(--purple-bg2);border-radius:10px;
  display:flex;align-items:center;justify-content:center;margin-bottom:12px;
}
.m-card h3{font-family:'Space Grotesk',sans-serif;font-size:17px;font-weight:700;color:var(--dark-text);margin-bottom:6px}
.m-card p{font-size:14px;color:var(--body-text);line-height:1.6}
.mirror-foot{text-align:center;margin-top:32px}
.mirror-foot p{
  font-family:'Space Grotesk',sans-serif;
  font-size:17px;font-weight:700;color:var(--dark-text);margin-bottom:16px;
}
.mirror-foot p span{color:var(--primary-purple)}

/* ============================================
   SECTION 3: TESTIMONIALS
   ============================================ */
.testi{padding:60px 0;background:var(--white)}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.testi-row2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;max-width:66.66%;margin:16px auto 0}
.t-card{background:var(--light-grey);border-radius:12px;overflow:hidden;transition:all .3s ease}
.t-card:hover{transform:translateY(-3px);box-shadow:0 10px 32px rgba(127,0,255,.08)}
.t-video{position:relative;padding-bottom:56.25%;height:0;background:#111}
.t-video iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:none}
.t-info{padding:14px 18px}
.t-stars{color:var(--yellow-accent);font-size:14px;margin-bottom:4px;letter-spacing:1px}
.t-name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:14px;color:var(--dark-text)}
.t-meta{font-size:11px;color:var(--muted);margin-top:1px}
.t-result{
  display:inline-block;margin-top:6px;font-size:11px;font-weight:700;
  color:var(--primary-purple);background:var(--purple-bg2);
  padding:3px 10px;border-radius:100px;
}
.testi-foot{text-align:center;margin-top:28px}

/* ============================================
   SECTION 4: THE TRUTH
   ============================================ */
.truth{padding:60px 0;background:var(--charcoal);position:relative;overflow:hidden}
.truth::before{
  content:'';position:absolute;bottom:-80px;right:-80px;
  width:360px;height:360px;
  background:radial-gradient(circle,rgba(127,0,255,.1),transparent 70%);pointer-events:none;
}
.truth .section-tag{background:rgba(255,214,0,.1);color:var(--yellow-accent)}
.truth .section-title{color:var(--white)}

.truth-stack{max-width:640px;position:relative;z-index:1}
.tl{
  font-size:18px;line-height:1.75;padding:8px 0;
  color:rgba(255,255,255,.82);
  border-bottom:1px solid rgba(255,255,255,.05);
  transition:padding-left .25s ease;
}
.tl:hover{padding-left:10px}
.tl:last-child{border-bottom:none}
.tl .y{color:var(--yellow-accent);font-weight:700}
.tl em{color:var(--light-purple);font-style:italic}

.truth-box{
  margin-top:28px;padding:24px;
  background:rgba(127,0,255,.08);border:1px solid rgba(127,0,255,.18);
  border-radius:12px;display:flex;align-items:center;gap:14px;
}
.truth-box-ic{
  width:44px;height:44px;min-width:44px;
  background:var(--primary-purple);border-radius:10px;
  display:flex;align-items:center;justify-content:center;
}
.truth-box-txt{font-size:17px;font-weight:700;color:var(--white);font-family:'Space Grotesk',sans-serif;line-height:1.4}
.truth-box-txt span{color:var(--yellow-accent)}
.truth-foot{margin-top:28px}

/* ============================================
   SECTION 5: WHAT YOU'LL LEARN
   ============================================ */
.learn{padding:60px 0;background:var(--off-white)}
.learn-list{display:flex;flex-direction:column;gap:14px;max-width:660px}
.l-item{
  display:flex;gap:14px;padding:22px;background:var(--white);
  border-radius:12px;border:1px solid transparent;
  transition:all .3s ease;
}
.l-item:hover{border-color:var(--primary-purple);transform:translateX(5px);box-shadow:0 4px 16px rgba(127,0,255,.05)}
.l-num{
  font-family:'Space Grotesk',sans-serif;font-size:28px;font-weight:800;
  color:var(--primary-purple);opacity:.2;line-height:1;min-width:36px;
}
.l-text h3{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700;color:var(--dark-text);margin-bottom:3px}
.l-text p{font-size:14px;color:var(--body-text);line-height:1.6}
.learn-close{margin-top:24px;font-size:15px;color:var(--body-text);max-width:540px;line-height:1.6;font-weight:500}
.learn-foot{margin-top:24px}

/* ============================================
   SECTION 6: MID CTA
   ============================================ */
.cta-band{
  padding:52px 0;text-align:center;
  background:linear-gradient(135deg,var(--primary-purple),var(--deep-purple));
}
.cta-band .section-title{color:var(--white);margin-bottom:6px}
.cta-band p{color:rgba(255,255,255,.82);font-size:16px;margin-bottom:24px}

/* ============================================
   SECTION 7: FOR / NOT FOR
   ============================================ */
.filter{padding:60px 0;background:var(--white)}
.f-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.f-col{background:var(--light-grey);border-radius:12px;padding:26px}
.f-col h3{
  font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:700;
  margin-bottom:18px;display:flex;align-items:center;gap:8px;
}
.f-col.yes h3{color:#16a34a}
.f-col.no h3{color:#dc2626}
.f-list{list-style:none}
.f-list li{
  padding:9px 0;border-bottom:1px solid var(--soft-grey);
  font-size:14px;color:var(--body-text);
  display:flex;align-items:flex-start;gap:10px;line-height:1.55;
}
.f-list li:last-child{border-bottom:none}
.f-ic{font-size:15px;flex-shrink:0;margin-top:2px}
.filter-foot{text-align:center;margin-top:24px}

/* ============================================
   SECTION 8: FAQ
   ============================================ */
.faq{padding:60px 0;background:var(--off-white)}
.faq-list{max-width:660px;display:flex;flex-direction:column;gap:10px}
.faq-item{border:1px solid var(--soft-grey);border-radius:10px;overflow:hidden;background:var(--white);transition:border-color .25s}
.faq-item:hover{border-color:var(--primary-purple)}
.faq-q{
  width:100%;background:none;border:none;
  padding:16px 22px;font-family:'Space Grotesk',sans-serif;
  font-size:15px;font-weight:600;color:var(--dark-text);
  text-align:left;cursor:pointer;display:flex;justify-content:space-between;align-items:center;
}
.faq-q .ic{font-size:18px;color:var(--primary-purple);transition:transform .25s;flex-shrink:0}
.faq-item.open .faq-q .ic{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease}
.faq-item.open .faq-a{max-height:220px}
.faq-a-inner{padding:0 22px 16px;font-size:14px;color:var(--body-text);line-height:1.65}
.faq-foot{margin-top:24px}

/* ============================================
   SECTION 9: FINAL CTA
   ============================================ */
.final{
  padding:72px 0;text-align:center;position:relative;overflow:hidden;
  background:linear-gradient(150deg,var(--black),#140028,var(--charcoal));
}
.final::before{
  content:'';position:absolute;top:50%;left:50%;
  width:440px;height:440px;
  background:radial-gradient(circle,rgba(127,0,255,.1),transparent 70%);
  transform:translate(-50%,-50%);pointer-events:none;
}
.final-h{
  font-family:'Space Grotesk',sans-serif;
  font-size:clamp(22px,3.8vw,38px);font-weight:800;
  color:var(--white);margin-bottom:10px;line-height:1.2;
  position:relative;z-index:1;
}
.final-h span{color:var(--yellow-accent)}
.final-sub{font-size:16px;color:rgba(255,255,255,.58);margin-bottom:28px;position:relative;z-index:1}

/* ============================================
   STICKY BAR
   ============================================ */
.sticky{
  position:fixed;bottom:0;left:0;right:0;
  background:var(--white);border-top:2px solid var(--soft-grey);
  padding:8px 16px;display:none;
  align-items:center;justify-content:space-between;
  z-index:9999;box-shadow:0 -4px 20px rgba(0,0,0,.08);
}
.sticky-txt{font-size:12px;color:var(--dark-text);font-weight:700;font-family:'Space Grotesk',sans-serif;line-height:1.3}
.sticky-txt small{display:block;font-size:10px;color:var(--muted);font-weight:500}
.sticky .cta-btn{padding:10px 18px;font-size:13px;animation:none;white-space:nowrap}

/* ============================================
   RESPONSIVE
   ============================================ */
@media(max-width:900px){
  .hero-grid{grid-template-columns:1fr;gap:0;text-align:center}
  .pre-hl{align-self:center}
  .hero-sub{margin-left:auto;margin-right:auto}
  .hero-img-mobile{display:block;margin:20px auto 0;max-width:380px}
  .hero-right{display:none}
  .hero-meta{justify-content:center;margin-top:20px}
  .hero-cta{display:flex;flex-direction:column;align-items:center}
  .hero-cta .cta-group{justify-content:center}
  .mirror-grid{grid-template-columns:1fr}
  .testi-grid{grid-template-columns:1fr}
  .testi-row2{grid-template-columns:1fr;max-width:100%}
  .f-grid{grid-template-columns:1fr}
  .tl{font-size:16px}
  .truth-box{flex-direction:column;text-align:center}
  .sticky{display:flex}
  body{padding-bottom:60px}
}
@media(max-width:480px){
  .hero{padding:36px 0 32px}
  .hero-h{font-size:22px}
  .hero-sub{font-size:14px}
  .cta-btn{width:100%;font-size:14px;padding:13px 18px}
  .section-title{font-size:20px}
  .m-card{padding:18px}
  .tl{font-size:14px}
  .l-item{padding:16px}
  .final-h{font-size:20px}
  .hero-img-mobile{max-width:100%}
}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
}
</style>
</head>
<body>

<!-- ============================================
     SECTION 1: HERO
     ============================================ -->
<section class="hero" id="top">
  <div class="hero-particles">
    <div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div>
  </div>
  <div class="container">
    <div class="hero-grid">

      <!-- LEFT COLUMN -->
      <div class="hero-left">
        <!-- ADMIN: Edit pre-headline -->
        <div class="pre-hl">For boutique owners stuck at the same revenue every month</div>

        <!-- ADMIN: Edit headline lines -->
        <h1 class="hero-h">
          <span class="ln">You're working harder than ever.</span>
          <span class="ln">Your boutique isn't growing.</span>
          <span class="ln">It's not your effort — it's the system.</span>
        </h1>

        <!-- ADMIN: Edit subheadline -->
        <p class="hero-sub">Join a 3-hour live session that shows you exactly why you're stuck — and the simple system that lets your boutique run even when you're not there.</p>

        <!-- MOBILE ONLY: Image/video appears here between subheadline and dateline -->
        <div class="hero-img-mobile">
          <div class="hero-frame">
            <!-- ADMIN: Replace placeholder with <img> or video embed -->
            <div class="hero-placeholder">
              <svg width="36" height="36" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              <span>Replace with image or video</span>
            </div>
